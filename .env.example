# ── Cloudflare ───────────────────────────────────────────────────────────────
# Tunnel token from Zero Trust → Networks → Tunnels → <tunnel> → token (run mode)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Traefik dashboard ─────────────────────────────────────────────────────────
# Generate with:  htpasswd -nb admin 'your-password'   (escape every $ as $$ here)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=admin
POSTGRES_SUPERUSER_PASSWORD=
# One login role per app, each scoped to its own database (defence in depth: a
# leaked app password is confined to that app's data). Roles: auth_user,
# money_user, recipes_user, notes_user.
AUTH_DB_PASSWORD=
MONEY_DB_PASSWORD=
RECIPES_DB_PASSWORD=
NOTES_DB_PASSWORD=

# ── Auth service ──────────────────────────────────────────────────────────────
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of emails permitted to sign in
ALLOWED_EMAILS=

# ── AI Chat ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Prague
