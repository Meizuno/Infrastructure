# ── Cloudflare ───────────────────────────────────────────────────────────────
# Tunnel token from Zero Trust → Networks → Tunnels → <tunnel> → token (run mode)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Traefik dashboard ─────────────────────────────────────────────────────────
# Generate with:  htpasswd -nb admin 'your-password'   (escape every $ as $$ here)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=admin
POSTGRES_SUPERUSER_PASSWORD=
# Password for the shared `web` role that owns all app databases
WEB_DB_PASSWORD=

# ── Auth service ──────────────────────────────────────────────────────────────
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of emails permitted to sign in
ALLOWED_EMAILS=

# ── AI Chat ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Shared secret every app uses to expose / call MCP tools
MCP_API_KEY=

# ── Whisper (optional overrides; sensible defaults in compose.yaml) ────────────
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Prague
