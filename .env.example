# ── Cloudflare ───────────────────────────────────────────────────────────────
# Tunnel token from Zero Trust → Networks → Tunnels → <tunnel> → token (run mode)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Traefik dashboard ─────────────────────────────────────────────────────────
# Generate with:  htpasswd -nb admin 'your-password'   (escape every $ as $$ here)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=admin
POSTGRES_SUPERUSER_PASSWORD=
# Shared login role that owns all app databases (used in every app's DATABASE_URL)
WEB_DB_USER=web
WEB_DB_PASSWORD=

# ── Auth service ──────────────────────────────────────────────────────────────
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of emails permitted to sign in
ALLOWED_EMAILS=

# ── AI Chat ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Prague
