# Template for .env. On a SOPS-managed host the canonical secrets live encrypted
# in secrets.enc.env (./scripts/secrets.sh) and .env is generated from it at
# deploy time — see README → "Secrets at rest (SOPS + age)".
#
# ── Cloudflare ───────────────────────────────────────────────────────────────
# Tunnel token from Zero Trust → Networks → Tunnels → <tunnel> → token (run mode)
CLOUDFLARE_TUNNEL_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=admin
POSTGRES_SUPERUSER_PASSWORD=
# One login role per app, each scoped to its own database (defence in depth: a
# leaked app password is confined to that app's data). Roles: auth_user,
# money_user, recipes_user, notes_user, calories_user.
AUTH_DB_PASSWORD=
MONEY_DB_PASSWORD=
RECIPES_DB_PASSWORD=
NOTES_DB_PASSWORD=
CALORIES_DB_PASSWORD=

# ── Auth service ──────────────────────────────────────────────────────────────
# Access tokens are signed with EdDSA; the private key is a FILE secret
# (secrets/jwt_private_key.pem via scripts/gen-jwt-key.sh), not an env value.
# JWT_SECRET is the LEGACY HS256 secret, kept only to verify in-flight HS256
# tokens during the EdDSA cutover. Once they have expired (≤15 min after the
# auth service is deployed with EdDSA), blank this and redeploy authentication
# to stop accepting HS256 entirely. See README → "Token signing".
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowed login emails and post-login redirect URLs are managed at runtime in
# the admin console (auth.meizuno.com/admin), not here.
# Comma-separated emails granted the admin role (the bootstrap admin set that can
# reach /admin; a user's role is synced to this on every login).
ADMIN_EMAILS=

# ── Backups → Cloudflare R2 (S3-compatible; scripts/backup-db.sh) ─────────────
# S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=postgres
# R2 API token (Object Read & Write) → Access Key ID / Secret Access Key
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Backups are encrypted client-side with age before upload (R2 only sees
# ciphertext). The recipient (age public key) — leave empty to derive it from the
# host SOPS age key (~/.config/sops/age/keys.txt); set explicitly to use another.
BACKUP_AGE_RECIPIENT=
# Optional Uptime-Kuma push monitor; the backup pings it up/down so a failed (or
# never-run) backup raises an alert. Reached over the docker network (Kuma is
# behind Cloudflare Access with no host port), so use the INTERNAL URL — take the
# token from Kuma's push URL and write:  http://uptime-kuma:3001/api/push/<token>
KUMA_PUSH_URL=

# ── AI Chat ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Postgres password for the `chat` DB (per-user chat history). On an EXISTING
# cluster the init script won't create the DB — provision it once first
# (see README → Notes & caveats → "Adding a new app DB to an existing cluster").
CHAT_DB_PASSWORD=

# ── Beszel (server metrics: CPU / RAM / disk) ─────────────────────────────────
# Obtained on FIRST RUN from the Beszel hub UI: create the admin account, then
# "Add System" (host/port are irrelevant — the agent dials the hub over the edge
# network) — the dialog shows both values. KEY is the hub's public key (not
# secret); TOKEN authenticates this system (keep secret). After setting them:
# ./scripts/secrets.sh decrypt && docker compose up -d beszel-agent.
BESZEL_KEY=
BESZEL_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Prague
