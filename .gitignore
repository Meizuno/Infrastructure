# Secrets & local config — never commit. The plaintext env files are derived
# from their SOPS-encrypted sources (secrets*.enc.env, which ARE committed).
.env
# Each app's plaintext secrets, beside its compose file (apps/forma/forma.env, …).
apps/*/*.env
# The same files where they lived before apps/<app>/ — kept ignored until the
# host's copies are deleted.
forma.env
english.env
notes.env
monitoring.env
config/ai-chat.yml
# Host-only secret files mounted into containers (JWT signing key, etc.)
secrets/
# Private age keys, if ever generated inside the repo (the canonical location is
# ~/.config/sops/age/keys.txt). secrets.enc.env (SOPS-encrypted) IS committed.
*.agekey
age-keys.txt
keys.txt

# OS / editor
.DS_Store
*.swp
