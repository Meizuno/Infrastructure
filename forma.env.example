# Forma app secrets — kept SEPARATE from the shared stack secrets (.env).
#
# Managed with SOPS like the main secrets: the committed, encrypted source is
# secrets.forma.enc.env; the plaintext forma.env is derived, gitignored,
# 0600, and loaded by compose.forma.yaml via `env_file`. Because env_file
# injects these straight into the container, use the app's REAL variable names
# (no FORMA_ prefix).
#
# Create / edit / materialize:
#   ./scripts/secrets.sh edit forma        # edit secrets.forma.enc.env
#   ./scripts/secrets.sh decrypt           # writes BOTH .env and forma.env
#
# (FORMA_DB_PASSWORD stays in the main .env — Postgres init needs it too.)

# Signs the HS256 access tokens. Required in prod, >= 32 chars:
#   openssl rand -base64 48
JWT_SECRET=

# Forma's OWN Google OAuth client (separate from the auth service's). Register
# https://forma.meizuno.com/api/auth/google/callback as its redirect URI (the
# old calories.meizuno.com URI can be dropped once traffic has moved — that host
# only 301s to forma now).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional sign-in allowlist (comma-separated). Unset → the default in config.go.
# GOOGLE_ALLOWED_EMAILS=
