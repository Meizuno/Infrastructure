# English app secrets — kept SEPARATE from the shared stack secrets (.env).
#
# Managed with SOPS like the main secrets: the committed, encrypted source is
# secrets.english.enc.env; the plaintext english.env is derived, gitignored,
# 0600, and loaded by compose.english.yaml via `env_file`. Because env_file
# injects these straight into the container, use the app's REAL variable names
# (the ENGLISH_ prefix is the app's own, not a stack convention).
#
# Create / edit / materialize:
#   ./scripts/secrets.sh edit english      # edit secrets.english.enc.env
#   ./scripts/secrets.sh decrypt           # writes every plaintext env file
#
# (ENGLISH_DB_PASSWORD stays in the main .env — Postgres init needs it too.)

# Signs the HS256 session cookie. REQUIRED, >= 32 chars (the app refuses to
# start without it):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENGLISH_JWT_SECRET=

# English's OWN Google OAuth client (separate from the auth service's and from
# forma's). Register https://english.meizuno.com/api/auth/google/callback as
# its authorized redirect URI.
ENGLISH_GOOGLE_CLIENT_ID=
ENGLISH_GOOGLE_CLIENT_SECRET=

# Who may sign in: comma-separated emails and/or "@domain.com" for a whole
# domain, or * for any Google account (with subscriptions on: 3 free sessions,
# then Stripe). EMPTY MEANS NOBODY — Google on its own would let any account in,
# so this is the actual gate. Not secret, but it belongs with the OAuth client.
ENGLISH_ALLOWED_EMAILS=

# Generates the exercises (structured outputs). Needed because
# compose.english.yaml sets ENGLISH_GENERATOR=openai; switch that to `fake` for
# canned exercises and this can stay empty. Separate from the ai-chat stack's
# OPENAI_API_KEY in the main .env.
ENGLISH_OPENAI_API_KEY=

# Subscriptions (Stripe). All three, or English sells nothing and withholds
# nothing. The price is the recurring price_… (not the product). The webhook
# endpoint is https://english.meizuno.com/api/billing/webhook with
# checkout.session.completed and customer.subscription.created/updated/deleted;
# its signing secret goes here. Same Stripe account as Forma is fine — each
# app ignores the other's customers. See English api/README.md, "Підписка".
ENGLISH_STRIPE_SECRET_KEY=
ENGLISH_STRIPE_WEBHOOK_SECRET=
ENGLISH_STRIPE_PRICE_ID=
