# Notes app secrets — kept SEPARATE from the shared stack secrets (.env).
#
# Managed with SOPS like the main secrets: the committed, encrypted source is
# secrets.notes.enc.env; the plaintext notes.env is derived, gitignored,
# 0600, and loaded by compose.notes.yaml via `env_file`. Because env_file
# injects these straight into the container, use the app's REAL variable names
# (the NOTES_ prefix is the app's own, not a stack convention).
#
# Create / edit / materialize:
#   ./scripts/secrets.sh edit notes        # edit secrets.notes.enc.env
#   ./scripts/secrets.sh decrypt           # writes every plaintext env file
#
# (NOTES_DB_PASSWORD stays in the main .env — Postgres init needs it too.)

# Signs the HS256 access tokens. REQUIRED, >= 32 chars (the image refuses to
# start without it). Rotating it signs everybody out:
#   openssl rand -base64 48
NOTES_JWT_SECRET=

# Notes' OWN Google OAuth client (separate from the auth service's, forma's
# and english's). Register https://notes.meizuno.com/api/auth/callback as its
# authorized redirect URI — compose.notes.yaml sets NOTES_GOOGLE_REDIRECT_URL to
# exactly that. REQUIRED: with the redirect URL set and these empty, the app
# refuses to start ("half configured"), and Google is the only way to sign in.
NOTES_GOOGLE_CLIENT_ID=
NOTES_GOOGLE_CLIENT_SECRET=

# Who may sign in: comma-separated e-mails, case-insensitive. EMPTY LETS NOBODY
# IN — the vault stays closed until it is opened on purpose. Here and not in the
# compose file because the addresses are personal data.
NOTES_ALLOWED_EMAILS=
