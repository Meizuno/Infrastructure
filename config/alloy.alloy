// Alloy: discover every container on the local docker daemon and ship its logs
// to Loki. One agent, read-only socket, no per-app configuration.
//
// Levels are mostly left to Loki: 3.x sets `detected_level` on ingest
// (discover_log_levels in config/loki.yaml), and reads JSON (Nuxt, Forma) and Go
// slog right. Filter in Grafana with `detected_level=~"warn|error"`. The one
// format it misreads is Python's plain text — see loki.process "python_text".

logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

// Turn docker's metadata into labels worth querying on. Keep this list short —
// every label is a separate Loki stream.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  // Compose service name: stable across rollout replicas, unlike the container
  // name (meizuno-forma-91, meizuno-forma-92, ...).
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Drop alloy's own logs so it cannot feed itself, and code-server's, which
  // is a dev sandbox on the same host rather than part of the stack — its
  // output is high-volume and says nothing about whether the apps are healthy.
  // Alloy watches the whole docker daemon, so anything else running outside the
  // `meizuno` project lands here too; to keep ONLY the stack, replace this rule
  // with a keep on __meta_docker_container_label_com_docker_compose_project.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "alloy|code-server"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { job = "docker" }
  forward_to = [loki.process.drop_backlog.receiver]
}

// On a first start Alloy has no saved position and reads each container's log
// file from the BEGINNING. The stack's containers run for months, so without
// this it would replay the whole backlog into Loki, which rejects old entries
// with HTTP 400 — a flood of errors and no usable logs.
//
// 1h, not 24h, and that difference matters. Loki refuses old data in TWO
// places: the distributor at reject_old_samples_max_age (24h), and the
// ingester at a per-stream window of about 2h ("entry too far behind").
// A 24h drop window therefore still let rejects through on both counts — and
// matching 24h exactly also raced the boundary, producing rejects one second
// over the line. 1h sits comfortably inside both limits.
loki.process "drop_backlog" {
  stage.drop {
    older_than          = "1h"
    drop_counter_reason = "backlog_older_than_loki_accepts"
  }

  forward_to = [loki.process.python_text.receiver]
}

// uvicorn and English print plain "LEVEL:    message" lines, and Loki 3.6
// files "ERROR:" under detected_level=unknown — INFO:, WARNING: and CRITICAL:
// it reads, ERROR: it does not. So the apps' errors were invisible to every
// warn/error filter, Forma's uvicorn ones and all of English's. The level is
// taken from the prefix here and handed over as `level`, which Loki copies
// into detected_level verbatim — hence the lower case, and warn rather than
// WARNING, to match what it detects on its own everywhere else.
loki.process "python_text" {
  // A traceback is printed one line at a time, so without this each of its
  // lines is a separate entry of unknown level, read bottom-up in a newest-first
  // panel. Everything English prints carries a prefix, so a line without one
  // continues the entry before it. Not Forma: it prints httpx's bare
  // "HTTP Request: …" lines, which this would glue onto whatever came before,
  // and its own handler already logs each crash as one JSON line with the
  // traceback inside; only uvicorn's text copy of it stays line by line.
  stage.match {
    selector = "{service=\"english\"}"

    stage.multiline {
      firstline     = "^(?:DEBUG|INFO|WARNING|ERROR|CRITICAL):"
      max_wait_time = "3s"
    }
  }

  stage.regex {
    expression = "^(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL):\\s"
  }

  stage.template {
    source   = "level"
    template = "{{ if eq .Value \"WARNING\" }}warn{{ else }}{{ ToLower .Value }}{{ end }}"
  }

  stage.structured_metadata {
    values = { level = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
