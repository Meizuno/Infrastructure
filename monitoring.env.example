# Monitoring secrets — kept SEPARATE from the shared stack secrets (.env),
# the same split forma and english use.
#
# Managed with SOPS: the committed, encrypted source is
# secrets.monitoring.enc.env; the plaintext monitoring.env is derived,
# gitignored, 0600, and loaded by compose.monitoring.yaml via `env_file`.
# Because env_file injects these straight into the containers, use the real
# variable names the images expect.
#
#   ./scripts/secrets.sh edit monitoring    # edit secrets.monitoring.enc.env
#   ./scripts/secrets.sh decrypt            # writes every plaintext env file

# Grafana's initial admin password. Only read on FIRST start (it seeds the
# account); changing it later needs `grafana-cli admin reset-admin-password`
# or a UI change. >= 16 chars:
#   openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=

# postgres-exporter's connection string. It is the whole DSN, password included,
# which is why it lives here rather than in compose.
#
# `admin` is the maintenance database (POSTGRES_SUPERUSER names it), not a typo
# for `postgres`. Create the role ONCE with the superuser — pg_monitor alone is
# not enough, because PUBLIC's CONNECT is revoked on every app database, so
# without the per-database grants the exporter reports cluster-wide stats only:
#
#   docker compose exec -T postgres psql -v ON_ERROR_STOP=1 \
#     -U "${POSTGRES_SUPERUSER:-admin}" -d "${POSTGRES_SUPERUSER:-admin}" <<SQL
#   CREATE ROLE monitoring LOGIN PASSWORD '<the password below>';
#   GRANT pg_monitor TO monitoring;
#   GRANT CONNECT ON DATABASE authentication, money_manager, recipes_book,
#         notes, forma, english, chat TO monitoring;
#   SQL
#
# Use a hex password (openssl rand -hex 24) — it goes inside a URL, so @ : / ?
# would corrupt the DSN.
DATA_SOURCE_NAME=postgresql://monitoring:<password>@postgres:5432/admin?sslmode=disable
